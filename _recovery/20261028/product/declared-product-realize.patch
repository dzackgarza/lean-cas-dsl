+/-- A legacy defining-leg descriptor is available only for a unique accepted
+cone that retains the independently selected complete ordered coordinates.
+This chooses a public encoding, never the mathematical product or its mediator. -/
+private def operationProductLegRow? (context : CategoryContext)
+    (selected : DeclaredProduct.Selection) (diagram presentation : Expr) :
+    TermElabM (Option LimitEntry) := do
+  let closed : Expr → TermElabM Bool := fun value => do
+    let value ← instantiateMVars value
+    let type ← instantiateMVars (← inferType value)
+    pure (ConstrainedPoint.closed value && ConstrainedPoint.closed type)
+  for value in #[context.bundle, diagram, presentation, selected.endpoint] ++
+      selected.coordinates ++ selected.factors do
+    unless ← closed value do return none
+  discard <| StructuredResult.checkReconstruction context.bundle
+  let diagram ← StructuredResult.checkReconstruction diagram
+  let selectedCone ← StructuredResult.checkReconstruction
+    (← mkAppM ``CategoryTheory.Limits.LimitCone.cone #[presentation])
+  let indices ← #[``CategoryTheory.Limits.WalkingPair.left,
+      ``CategoryTheory.Limits.WalkingPair.right].mapM fun name =>
+    mkAppM ``CategoryTheory.Discrete.mk #[mkConst name]
+  unless indices.size == selected.coordinates.size &&
+      indices.size == selected.factors.size do
+    throwError "the checked coordinate descriptor lost its ordered binary fields"
+  let state ← registryState
+  let mut matchingRows : Array LimitEntry := #[]
+  for row in state.limits do
+    if row.colimit then continue
+    let matchesRow ← withoutModifyingState do
+      try
+        let some category := state.categories.find? (·.id == row.category)
+          | throwError "the accepted defining-leg descriptor lost its registered category"
+        let declaration ← instantiateFresh row.declaration
+        let declaredType ← whnfR (← inferType declaration)
+        unless declaredType.isAppOf ``CategoryTheory.Limits.LimitCone do
+          throwError "the accepted defining-leg descriptor has no full limit-cone type"
+        let declaredDiagram := declaredType.appArg!
+        unless ← withTransparency .all <|
+            isDefEq (← inferType declaredDiagram) (← inferType diagram) do return false
+        -- This optional descriptor must publish the actual diagram syntax used
+        -- below. An equal cone with another constructor still uses component fields.
+        let some constructor ← Semantic.diagramConstructor row | return false
+        unless diagram.getAppFn.constName? == some constructor do return false
+        let candidate ← Semantic.limitPresentation row diagram
+        unless ← closed candidate do return false
+        let candidate ← StructuredResult.checkReconstruction candidate
+        let cone ← mkAppM ``CategoryTheory.Limits.LimitCone.cone #[candidate]
+        let coneType ← whnfR (← inferType cone)
+        unless coneType.isAppOf ``CategoryTheory.Limits.Cone do
+          throwError "the accepted defining-leg descriptor lost its full cone"
+        let candidateDiagram := coneType.appArg!
+        let diagramType ← whnfR (← inferType candidateDiagram)
+        unless diagramType.isAppOfArity ``CategoryTheory.Functor 4 do
+          throwError "the accepted defining-leg descriptor lost its full diagram category"
+        let arguments := diagramType.getAppArgs
+        let bundle ← instantiateMVars (← mkAppOptM ``CategoryTheory.Cat.of
+          #[some arguments[2]!, some arguments[3]!])
+        unless ← closed bundle do return false
+        let candidateContext ← CategoryContext.presented
+          { expression := category.expression, bundle }
+        let .ok compatible ← CategoryContext.compatible context candidateContext
+          | return false
+        unless compatible do return false
+        unless ← withTransparency .all <|
+            isDefEq (← inferType candidateDiagram) (← inferType diagram) <&&>
+              isDefEq candidateDiagram diagram <&&>
+              isDefEq (← inferType cone) (← inferType selectedCone) <&&>
+              isDefEq cone selectedCone do return false
+        let apex ← mkAppM ``CategoryTheory.Limits.Cone.pt #[cone]
+        unless ← withTransparency .all <| isDefEq apex selected.endpoint do return false
+        let maps ← mkAppM ``CategoryTheory.Limits.Cone.π #[cone]
+        for ((index, expected), target) in
+            (indices.zip selected.coordinates).zip selected.factors do
+          let actual ← mkAppM ``CategoryTheory.NatTrans.app #[maps, index]
+          unless ← closed actual do return false
+          CategoryContext.checkMorphism context actual selected.endpoint target
+          unless ← withTransparency .all <|
+              isDefEq (← inferType actual) (← inferType expected) <&&>
+                isDefEq actual expected do return false
+        return true
+      catch error =>
+        if Exception.interpretationKind error == .invalid then pure false else throw error
+    if matchesRow then matchingRows := matchingRows.push row
+  return match matchingRows with
+    | #[row] => some row
+    | _ => none
