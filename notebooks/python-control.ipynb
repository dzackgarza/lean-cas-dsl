   "source": [
    "def fib(n):\n",
    "    if n < 2:\n",
    "        return n\n",
    "    return fib(n - 1) + fib(n - 2)\n",
    "\n",
    "result = [fib(i) for i in range(10)]\n",
    "print(result)"
   ]
  }
