-- Independent structured observations supplement the preauthored kernel orders.
-- Mathematical source: groupsKernel(f)=kernelLimitCone(f), kernelFork(f)=
-- Fork.ofι(f.hom.ker.subtype). These assertions observe the actual construction
-- leg, not a separately named subgroup or a cardinality substitute.
-- This proposal changes neither the original corpus nor its admission ledgers.

let G := Sym(3) in Groups
let C2 := ZMod(2) in Groups
let s := sign(3)
let t := trivial(G, C2)
let e := id(G)
let Ks := kernel(s)
let Kt := kernel(t)
let Ke := kernel(e)
let A := Alt(3)
let Ad := view A along fun.subobjects_groups.domain
let ai := A.inclusion().hom()

test b0.groups.kernel.sign.defining_leg "Dummit–Foote ch. 3 section 1; kernelFork(sign(3)) uses the actual subgroup inclusion into the selected S_3, whose composite with sign is the trivial homomorphism into the selected Z/2":
  assert s ∘ Ks.leg(0) = trivial(Ks, C2)

test b0.groups.kernel.trivial.defining_leg "Dummit–Foote ch. 3 section 1; the kernel of the selected trivial S_3 to Z/2 homomorphism has its defining inclusion into that same S_3, and the composite is the trivial homomorphism from the actual kernel apex":
  assert t ∘ Kt.leg(0) = trivial(Kt, C2)

test b0.groups.kernel.identity.defining_leg "Dummit–Foote ch. 3 section 1; the kernel of id(S_3) is the identity subgroup with its actual inclusion into S_3; composing that inclusion with the selected identity is the trivial homomorphism from the actual kernel apex into S_3":
  assert e ∘ Ke.leg(0) = trivial(Ke, G)

test b0.groups.alternating3.defining_inclusion "Dummit–Foote ch. 1 section 3 and ch. 3 section 1: the actual alternating-subgroup inclusion A_3 into the selected S_3 consists of even permutations, and its composite with sign is trivial on its complete selected domain":
  assert s ∘ ai = trivial(Ad, C2)
