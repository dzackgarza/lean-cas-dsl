  assert twoElementSubsets.cardinality() = 10

-- Finite ordinals carry the existing numeral operation. The source of the
-- selected singleton is kept; repetition does not supply a second member.
let singletonZero := {0} in 𝒫_fin(existingFive)

test reconstructed_extensions_20261024.complete.rx02.singleton_excluded "[M02] singleton_not_member (Fin 5) 0":
  assert (singletonZero ∈ TwoSubsets(existingFive)) = false

