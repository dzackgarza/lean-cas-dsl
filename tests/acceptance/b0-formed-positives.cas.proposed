-- Proposed source for existing B0 formed-module obligations, not activated assertions.
-- Mathematical expectations precede candidate interpretation or execution.
-- Published owner: LeanCategories.Catalogue.Semantics.Modules.Bilinear.Valued.Constructions.

let b := ((a, b), (c, d)) ↦ a*d + b*c in BilinearMaps(ℤ, Vec(ℤ, 2), Vec(ℤ, 2), RegularModule(ℤ))

let U := BilinearForm(ℤ, Vec(ℤ, 2), RegularModule(ℤ), b)

let Uv := FormedModule(ℤ, Vec(ℤ, 2), RegularModule(ℤ), b)

test formed.card.hyperbolic_fixed "B0 cc-specimens: U=(ℤ², x₀y₁+x₁y₀); published BilinearForm retains that carrier and chosen form, and |ℤ²|=ℵ₀ (Mathlib Cardinal.mk_int and Cardinal.power_nat_eq)":
  assert |U| = ℵ₀

test formed.card.hyperbolic_variable "The same selected bilinear map in the published variable-value FormedModule constructor has the same carrier ℤ², hence cardinality ℵ₀ through its actual structural carrier functor":
  assert |Uv| = ℵ₀

let z := (x, y) ↦ 0 in BilinearMaps(ℤ, Vec(ℤ, 0), Vec(ℤ, 0), RegularModule(ℤ))

let Z := BilinearForm(ℤ, Vec(ℤ, 0), RegularModule(ℤ), z)

test formed.card.zero_rank_zero "B0 cc-realizer-first: the zero form on ℤ⁰ has the singleton carrier Fin 0 → ℤ (Mathlib Pi.uniqueOfIsEmpty), of cardinality one":
  assert |Z| = 1

let bu := formed_pairing(ℤ, Uv)

test formed.pairing.hyperbolic "B0 selected structures: the published variable-value pairing evaluates the selected form ad+bc; at (2,-1),(3,4) the value is 2·4+(-1)·3=5 in ℤ":
  assert bu((2, -1), (3, 4)) = 5

let b3 := ((a, b), (c, d)) ↦ 3*(a*d + b*c) in BilinearMaps(ℤ, Vec(ℤ, 2), Vec(ℤ, 2), RegularModule(ℤ))

let Uv3 := FormedModule(ℤ, Vec(ℤ, 2), RegularModule(ℤ), b3)

let bu3 := formed_pairing(ℤ, Uv3)

test formed.pairing.scaled_hyperbolic "B0 selected structures: the distinct chosen form 3(ad+bc) on the same ℤ² and with the same value module gives 3·5=15 at the same two vectors":
  assert bu3((2, -1), (3, 4)) = 15
